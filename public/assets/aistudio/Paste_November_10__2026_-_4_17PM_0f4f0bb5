                            </div>
                            <div class="flex flex-col sm:flex-row gap-2">
                                <input type="text" id="secretInput" spellcheck="false" autocomplete="off"
                                    class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-sm font-mono uppercase tracking-wider text-indigo-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition">
